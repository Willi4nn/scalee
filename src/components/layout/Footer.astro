---
import {
  Instagram,
  Linkedin,
  Mail,
  MapPin,
  MessageCircle,
  Phone,
} from 'lucide-astro';
import { CONTACT_INFO, FOOTER_LINKS, SOCIAL_LINKS } from '../../data/content';

const SocialIcons: Record<string, any> = {
  Instagram,
  Linkedin,
  MessageCircle,
};

const linkSections = [
  { title: 'Soluções', links: FOOTER_LINKS.solucoes },
  { title: 'Empresa', links: FOOTER_LINKS.empresa },
];
---

<footer class="border-t border-white/10 bg-slate-950 pt-16 pb-8 text-slate-400">
  <div class="container mx-auto px-6 md:px-8">
    <div
      class="mb-16 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8"
    >
      <div class="flex flex-col gap-6 sm:col-span-2 lg:col-span-4">
        <a
          href="#top"
          class="focus-visible:ring-primary flex w-fit items-center gap-2.5 rounded-md outline-none focus-visible:ring-2"
        >
          <img src="/scalee-logo.svg" alt="Logo Scalee" class="h-8 w-8" />
          <span class="text-xl font-bold tracking-tight text-white">Scalee</span
          >
        </a>

        <p class="max-w-75 text-[0.95rem] leading-relaxed text-slate-400">
          Transformamos processos manuais em sistemas inteligentes para sua
          empresa escalar com eficiência.
        </p>

        <div class="mt-2 flex items-center gap-3">
          {
            SOCIAL_LINKS.map((social) => {
              const Icon = SocialIcons[social.icon];
              return (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="focus-visible:ring-primary rounded-full bg-white/5 p-2.5 text-slate-400 transition-all outline-none hover:bg-white/10 hover:text-white focus-visible:ring-2 active:scale-95"
                  aria-label={`Acessar ${social.platform}`}
                >
                  <Icon class="h-5 w-5" stroke-width="1.5" />
                </a>
              );
            })
          }
        </div>
      </div>

      {
        linkSections.map((section) => (
          <div class="col-span-1 lg:col-span-2">
            <h4 class="mb-5 text-sm font-semibold tracking-wider text-white uppercase">
              {section.title}
            </h4>
            <ul class="flex flex-col gap-2.5">
              {section.links.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="focus-visible:text-primary inline-block text-[0.95rem] text-slate-400 transition-colors outline-none hover:text-white focus-visible:underline"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="sm:col-span-2 lg:col-span-4 lg:pl-4">
        <h4
          class="mb-5 text-sm font-semibold tracking-wider text-white uppercase"
        >
          Contato
        </h4>

        <address class="flex flex-col gap-4 not-italic">
          <a
            href={`mailto:${CONTACT_INFO.email}`}
            class="group focus-visible:text-primary flex w-fit items-start gap-3 text-[0.95rem] text-slate-400 transition-colors outline-none hover:text-white"
          >
            <Mail
              class="group-hover:text-primary mt-0.5 h-5 w-5 shrink-0 text-slate-500 transition-colors"
              stroke-width="1.5"
            />
            <span class="wrap-break-word">{CONTACT_INFO.email}</span>
          </a>
          <a
            href={`tel:+${CONTACT_INFO.phone}`}
            class="group focus-visible:text-primary flex w-fit items-start gap-3 text-[0.95rem] text-slate-400 transition-colors outline-none hover:text-white"
          >
            <Phone
              class="group-hover:text-primary mt-0.5 h-5 w-5 shrink-0 text-slate-500 transition-colors"
              stroke-width="1.5"
            />
            <span>{CONTACT_INFO.phoneFormatted}</span>
          </a>
          <div class="flex items-start gap-3 text-[0.95rem] text-slate-400">
            <MapPin
              class="mt-0.5 h-5 w-5 shrink-0 text-slate-500"
              stroke-width="1.5"
            />
            <span>{CONTACT_INFO.address}</span>
          </div>
        </address>
      </div>
    </div>

    <div
      class="flex flex-col-reverse items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-slate-500 sm:flex-row"
    >
      <p>© {new Date().getFullYear()} Scalee. Todos os direitos reservados.</p>
      <div class="flex items-center gap-6">
        {
          FOOTER_LINKS.recursos.map((item) => (
            <a
              href={item.href}
              class="focus-visible:text-primary transition-colors outline-none hover:text-white focus-visible:underline"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
