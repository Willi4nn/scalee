---
import { Instagram, Linkedin, Mail, MapPin, MessageCircle, Phone } from "lucide-astro";
import { CONTACT_INFO, FOOTER_LINKS, SOCIAL_LINKS } from "../../data/content";

const SocialIcons: Record<string, any> = {
  Instagram,
  Linkedin,
  MessageCircle
};

const linkSections = [
  { title: "Soluções", links: FOOTER_LINKS.solucoes },
  { title: "Empresa", links: FOOTER_LINKS.empresa },
];
---

<footer class="bg-slate-950 pt-16 pb-8 border-t border-white/10 text-slate-400">
  <div class="container px-6 md:px-8 mx-auto">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 mb-16">

      <div class="sm:col-span-2 lg:col-span-4 flex flex-col gap-6">
        <a href="#top" class="flex items-center gap-2.5 w-fit outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md">
          <img
            src="/scalee-logo.svg"
            alt="Logo Scalee"
            class="w-8 h-8"
          />
          <span class="text-xl font-bold text-white tracking-tight">Scalee</span>
        </a>

        <p class="text-[0.95rem] text-slate-400 leading-relaxed max-w-75">
          Transformamos processos manuais em sistemas inteligentes para sua empresa escalar com eficiência.
        </p>

        <div class="flex items-center gap-3 mt-2">
          {SOCIAL_LINKS.map((social) => {
            const Icon = SocialIcons[social.icon];
            return (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2.5 rounded-full bg-white/5 text-slate-400 hover:text-white hover:bg-white/10 transition-all active:scale-95 outline-none focus-visible:ring-2 focus-visible:ring-primary"
                aria-label={`Acessar ${social.platform}`}
              >
                <Icon class="w-5 h-5" stroke-width="1.5" />
              </a>
            );
          })}
        </div>
      </div>

      {linkSections.map((section) => (
        <div class="col-span-1 lg:col-span-2">
          <h4 class="text-white font-semibold mb-5 text-sm uppercase tracking-wider">{section.title}</h4>
          <ul class="flex flex-col gap-2.5">
            {section.links.map((item) => (
              <li>
                <a href={item.href} class="inline-block text-[0.95rem] text-slate-400 hover:text-white transition-colors outline-none focus-visible:text-primary focus-visible:underline">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="sm:col-span-2 lg:col-span-4 lg:pl-4">
        <h4 class="text-white font-semibold mb-5 text-sm uppercase tracking-wider">Contato</h4>

        <address class="flex flex-col gap-4 not-italic">
          <a href={`mailto:${CONTACT_INFO.email}`} class="flex items-start gap-3 text-[0.95rem] text-slate-400 hover:text-white transition-colors w-fit group outline-none focus-visible:text-primary">
            <Mail class="w-5 h-5 text-slate-500 group-hover:text-primary transition-colors shrink-0 mt-0.5" stroke-width="1.5" />
            <span class="wrap-break-word">{CONTACT_INFO.email}</span>
          </a>
          <a href={`tel:+${CONTACT_INFO.phone}`} class="flex items-start gap-3 text-[0.95rem] text-slate-400 hover:text-white transition-colors w-fit group outline-none focus-visible:text-primary">
            <Phone class="w-5 h-5 text-slate-500 group-hover:text-primary transition-colors shrink-0 mt-0.5" stroke-width="1.5" />
            <span>{CONTACT_INFO.phoneFormatted}</span>
          </a>
          <div class="flex items-start gap-3 text-[0.95rem] text-slate-400">
            <MapPin class="w-5 h-5 text-slate-500 shrink-0 mt-0.5" stroke-width="1.5" />
            <span>{CONTACT_INFO.address}</span>
          </div>
        </address>
      </div>

    </div>

    <div class="flex flex-col-reverse sm:flex-row items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-slate-500">
      <p>© {new Date().getFullYear()} Scalee. Todos os direitos reservados.</p>
      <div class="flex items-center gap-6">
        {FOOTER_LINKS.recursos.map((item) => (
          <a href={item.href} class="hover:text-white transition-colors outline-none focus-visible:text-primary focus-visible:underline">
            {item.label}
          </a>
        ))}
      </div>
    </div>

  </div>
</footer>
